<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_hr_hospital_doctor" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">hr.hospital.doctor</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_hr_hospital_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">hr.hospital.patient</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_hr_hospital_disease" model="ir.actions.act_window">
        <field name="name">Diseases</field>
        <field name="res_model">hr.hospital.disease</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_hr_hospital_visit" model="ir.actions.act_window">
        <field name="name">Patient Visits</field>
        <field name="res_model">hr.hospital.visit</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="hospital_doctor_category_action" model="ir.actions.act_window">
        <field name="name">Doctor Qualifications</field>
        <field name="res_model">hospital.doctor.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="hospital_doctor_history_action" model="ir.actions.act_window">
        <field name="name">Personal Doctor History</field>
        <field name="res_model">hospital.doctor.history</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hr_hospital_root" name="Hospital" sequence="10"/>
    <menuitem id="menu_hr_hospital_patient" name="Patients"
              parent="menu_hr_hospital_root" action="action_hr_hospital_patient" sequence="10"/>
    <menuitem id="menu_hr_hospital_doctor" name="Doctors"
              parent="menu_hr_hospital_root" action="action_hr_hospital_doctor" sequence="20"/>
    <menuitem id="menu_hr_hospital_visit" name="Patient Visits"
              parent="menu_hr_hospital_root" action="action_hr_hospital_visit" sequence="30"/>
    <menuitem id="menu_hr_hospital_disease" name="Diseases"
              parent="menu_hr_hospital_root" action="action_hr_hospital_disease" sequence="40"/>
    <menuitem id="menu_hospital_doctor_history" name="Personal Doctor History"
              parent="menu_hr_hospital_root" action="hospital_doctor_history_action" sequence="50"/>
    <menuitem id="menu_hospital_doctor_category" name="Doctor Qualifications"
              parent="menu_hr_hospital_root" action="hospital_doctor_category_action" sequence="60"/>
</odoo>
